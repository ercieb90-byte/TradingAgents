# ============================================================
# Portfolio Analyzer – Environment Configuration
# Copy this file to .env.portfolio and fill in your API keys.
# ============================================================

# ----------------------------------------------------------
# LLM Provider (choose one)
# ----------------------------------------------------------

# Option 1: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Llama API (OpenAI-compatible)
# LLAMA_API_KEY=LL-...

# ----------------------------------------------------------
# Market Data APIs (optional but strongly recommended)
# ----------------------------------------------------------

# Finnhub – Free at https://finnhub.io/
# Provides: company news, sentiment, earnings surprises, insider transactions, analyst consensus
FINNHUB_API_KEY=...

# FRED (Federal Reserve Economic Data) – Free at https://fred.stlouisfed.org/docs/api/
# Provides: Fed Funds Rate, CPI, GDP, VIX, yield curve, credit spreads, consumer sentiment
FRED_API_KEY=...

# ----------------------------------------------------------
# LLM Provider Switch
# ----------------------------------------------------------
# Uncomment to override the default provider (anthropic):
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=llama
